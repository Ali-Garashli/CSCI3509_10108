# ─────────────────────────────────────────────
# .gitignore — files Git should NOT track
# Each line is a pattern. Matching files never show up in `git status`.
# ─────────────────────────────────────────────

# Build output (CD rebuilds this on GitHub, so we never commit it)
dist/

# Node.js
node_modules/
npm-debug.log*
.npm/

# Visual Studio Code
# Personal editor settings stay on your machine...
.vscode/*
# ...but shared recommendations for the class are kept
!.vscode/extensions.json
*.code-workspace
.history/

# Operating system junk
.DS_Store
Thumbs.db
desktop.ini

# Secrets & local environment (never commit passwords or keys!)
.env
.env.*

# Logs and temporary files
*.log
*.tmp
*.swp